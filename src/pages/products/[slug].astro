---
import MainLayout from "../../layouts/MainLayout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const vehicles = await getCollection("vehicles");
  return vehicles.flatMap((v) => [
    { params: { lang: "zh", slug: v.data.slug } },
    { params: { lang: "en", slug: v.data.slug } },
  ]);
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const { t } = useTranslations(lang);
const isZh = lang === "zh";
const baseUrl = lang === "zh" ? "" : "/en";

const vehicles = await getCollection("vehicles");
const vehicle = vehicles.find((v) => v.data.slug === slug);
if (!vehicle) return Astro.redirect(`${baseUrl}/products/`);

const brands = await getCollection("brands");
const brand = brands.find((b) => b.id === vehicle.data.brand);

const v = vehicle.data;
const name = isZh ? v.names.zh : v.names.en;
const brandName = isZh ? (brand?.data.names.zh ?? v.brand) : (brand?.data.names.en ?? v.brand);
const typeLabel = t(`filter.${v.type.toLowerCase()}`);
const fuelLabel = v.fuelType === 'electric' ? (isZh ? '纯电动' : 'Electric') : v.fuelType === 'plug_in_hybrid' ? (isZh ? '插电混动' : 'PHEV') : v.fuelType === 'extended_range' ? (isZh ? '增程式' : 'EREV') : (isZh ? '燃油' : 'Petrol');

const specItems = [
  v.specs.range_km && { label: t("product.range"), value: `${v.specs.range_km} km` },
  v.specs.battery_kwh && { label: t("product.battery"), value: `${v.specs.battery_kwh} kWh` },
  v.specs.power_kw && { label: t("product.power"), value: `${v.specs.power_kw} kW` },
  v.specs.top_speed_kmh && { label: t("product.topSpeed"), value: `${v.specs.top_speed_kmh} km/h` },
  v.specs.seats && { label: t("product.seats"), value: `${v.specs.seats}` },
  v.specs.drive && { label: t("product.drive"), value: v.specs.drive },
  (v.specs.length_mm && v.specs.width_mm && v.specs.height_mm) && { label: t("product.dimensions"), value: `${v.specs.length_mm}×${v.specs.width_mm}×${v.specs.height_mm} mm` },
  v.specs.charging_fast && { label: t("product.chargingFast"), value: v.specs.charging_fast },
  v.specs.charging_slow && { label: t("product.chargingSlow"), value: v.specs.charging_slow },
  v.specs.engine && { label: isZh ? "发动机" : "Engine", value: v.specs.engine },
  v.specs.transmission && { label: isZh ? "变速箱" : "Transmission", value: v.specs.transmission },
].filter(Boolean);

const relatedVehicles = vehicles.filter((rv) => rv.data.brand === v.brand && rv.data.slug !== v.slug).slice(0, 4);
---

<MainLayout title={`${name} — 常州后浪新能源汽车进出口有限公司`} description={v.description[lang as keyof typeof v.description]}>
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-400 mb-6">
        <a href={`${baseUrl}/`} class="hover:text-accent">{t("nav.home")}</a>
        <span class="mx-2">/</span>
        <a href={`${baseUrl}/products/`} class="hover:text-accent">{t("nav.products")}</a>
        <span class="mx-2">/</span>
        <span class="text-slate-600">{name}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-10">
        <!-- Image Carousel -->
        <div>
          <div class="relative rounded-xl overflow-hidden bg-primary-light border border-white/5" id="carousel">
            <div class="aspect-[4/3] flex items-center justify-center overflow-hidden">
              <img id="main-image" src={v.images[0]} alt={name} class="w-full h-full object-contain" />
            </div>
            <button onclick="prevImage()" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-white/20 transition-colors border border-white/10">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button onclick="nextImage()" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-white/20 transition-colors border border-white/10">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
            <div class="flex gap-2 mt-3 justify-center" id="thumbnails">
              {v.images.map((img, i) => (
                <button onclick={`setImage(${i})`} class={`w-14 h-10 rounded-md overflow-hidden border-2 transition-all duration-200 ${i === 0 ? 'border-gold shadow-sm shadow-gold/20' : 'border-white/10 hover:border-white/30'}`}>
                  <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" onerror="this.remove()" />
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Details -->
        <div>
          <p class="text-sm text-gold font-bold uppercase tracking-wide">{brandName}</p>
          <h1 class="text-3xl font-extrabold mt-1 mb-3 text-white">{name}</h1>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">{v.description[lang as keyof typeof v.description]}</p>

          <div class="flex flex-wrap gap-1.5 mb-6">
            <span class="text-xs bg-white/5 text-gray-300 px-2.5 py-1 rounded-full border border-white/5">{typeLabel}</span>
            <span class="text-xs bg-white/5 text-gray-300 px-2.5 py-1 rounded-full border border-white/5">{fuelLabel}</span>
            {v.specs.drive && <span class="text-xs bg-white/5 text-gray-300 px-2.5 py-1 rounded-full border border-white/5">{v.specs.drive}</span>}
            <span class="text-xs bg-white/5 text-gray-300 px-2.5 py-1 rounded-full border border-white/5">{v.year}</span>
            {v.inStock && <span class="badge-green">{t("product.inStock")}</span>}
          </div>

          <!-- Specs -->
          {specItems.length > 0 && (
            <div class="mb-6">
              <h3 class="font-bold text-white mb-3">{t("product.specs")}</h3>
              <div class="grid grid-cols-2 gap-2">
                {specItems.map((s: any) => (
                  <div class="bg-primary-light border border-white/5 rounded-lg p-3">
                    <p class="text-[10px] text-gray-500 font-semibold uppercase">{s.label}</p>
                    <p class="text-sm font-bold text-white">{s.value}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <a href={`${baseUrl}/contact/`} class="btn-primary">
            {t("product.inquireNow")}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  {relatedVehicles.length > 0 && (
    <section class="py-12 bg-primary-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg font-bold text-white mb-5">{isZh ? `更多${brandName}车型` : `More from ${brandName}`}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {relatedVehicles.map((rv) => {
            const rn = isZh ? rv.data.names.zh : rv.data.names.en;
            return (
              <a href={`${baseUrl}/products/${rv.data.slug}/`} class="group card card-hover">
                <div class="aspect-[4/3] bg-primary-light flex items-center justify-center">
                  <img src={rv.data.images[0]} alt={rn} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.remove()" />
                </div>
                <div class="p-3"><p class="text-xs font-medium text-gray-300 truncate">{rn}</p></div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</MainLayout>

<script is:inline>
  var images = {JSON.stringify(v.images)};
  var idx = 0;
  function setImage(i) { idx = i; document.getElementById('main-image').src = images[i]; updateThumbs(); }
  function nextImage() { idx = (idx + 1) % images.length; document.getElementById('main-image').src = images[idx]; updateThumbs(); }
  function prevImage() { idx = (idx - 1 + images.length) % images.length; document.getElementById('main-image').src = images[idx]; updateThumbs(); }
  function updateThumbs() {
    document.querySelectorAll('#thumbnails button').forEach(function(b, i) {
      b.classList.toggle('border-accent', i === idx);
      b.classList.toggle('border-transparent', i !== idx);
    });
  }
</script>
