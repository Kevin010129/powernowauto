---
import MainLayout from "../../layouts/MainLayout.astro";
import { getLangFromUrl } from "../../i18n/utils";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const brands = await getCollection("brands");
  return brands.flatMap((b) => [
    { params: { lang: "zh", brand: b.data.slug } },
    { params: { lang: "en", brand: b.data.slug } },
  ]);
}

const { brand: brandSlug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const isZh = lang === "zh";
const baseUrl = lang === "zh" ? "" : "/en";

const brands = await getCollection("brands");
const brand = brands.find((b) => b.data.slug === brandSlug);
if (!brand) return Astro.redirect(`${baseUrl}/brands/`);

const vehicles = await getCollection("vehicles");
const brandVehicles = vehicles
  .filter((v) => v.data.brand === brand.data.id)
  .sort((a, b) => a.data.order - b.data.order);

const brandName = isZh ? brand.data.names.zh : brand.data.names.en;
---

<MainLayout title={`${brandName} — PowerNowAuto`} description={brand.data.description[lang as keyof typeof brand.data.description] || `${brandName}`}>
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-5">
        <div class="w-20 h-20 bg-white/10 rounded-2xl flex items-center justify-center text-2xl font-bold">{brandName.substring(0, 2)}</div>
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold">{brandName}</h1>
          <p class="text-blue-200 mt-1">{brandVehicles.length} {isZh ? "款车型" : "models"}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {brandVehicles.map((vehicle) => {
          const v = vehicle.data;
          const name = isZh ? v.names.zh : v.names.en;
          return (
            <a href={`${baseUrl}/products/${v.slug}/`} class="card-hover group bg-white rounded-2xl border border-gray-100 overflow-hidden">
              <div class="aspect-[4/3] bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center overflow-hidden relative">
                <img src={v.images[0]} alt={name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" onerror="this.style.display='none'" />
                <div class="absolute top-3 left-3 flex gap-1.5">
                  {v.inStock && <span class="badge-green text-[10px]">{isZh ? "现车" : "In Stock"}</span>}
                  {v.isNew && <span class="badge-blue text-[10px]">{isZh ? "新品" : "New"}</span>}
                </div>
              </div>
              <div class="p-4">
                <h3 class="text-sm font-bold text-gray-900 group-hover:text-primary transition-colors line-clamp-1">{name}</h3>
                <div class="flex gap-1 mt-2">
                  <span class="badge-blue text-[10px]">{v.type}</span>
                  <span class="badge-amber text-[10px]">{v.fuelType === 'electric' ? (isZh ? '电动' : 'EV') : v.fuelType === 'plug_in_hybrid' ? 'PHEV' : v.fuelType === 'extended_range' ? 'EREV' : (isZh ? '燃油' : 'Petrol')}</span>
                  <span class="text-[10px] text-gray-400">{v.year}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>
