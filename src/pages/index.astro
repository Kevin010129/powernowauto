---
export async function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}
import MainLayout from "../layouts/MainLayout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { t } = useTranslations(lang);
const isZh = lang === "zh";
const baseUrl = lang === "zh" ? "" : "/en";

const title = isZh
  ? "常州后浪新能源汽车进出口有限公司 — 中国汽车出口"
  : "PowerNowAuto — China Auto Export";
const description = isZh
  ? "专业从事新能源车与燃油车出口，覆盖50+品牌、300+车型，提供一站式全球汽车采购与出口服务。"
  : "Professional NEV and fuel vehicle export. 50+ brands, 300+ models. One-stop global auto export.";
---

<MainLayout {title} {description}>

  <!-- ═══════════ HERO (Apple-style centered + big headline) ═══════════ -->
  <section class="relative min-h-[80vh] flex items-center justify-center bg-white overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-apple-blue/[0.02] rounded-full blur-[200px] -translate-y-1/3 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gray-200/20 rounded-full blur-[160px] translate-y-1/3 -translate-x-1/4"></div>
    </div>

    <div class="relative w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 text-center">
      <p class="section-label text-center">{t("home.badge")}</p>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[1.08] mb-6 tracking-tight text-apple-text">
        {isZh ? "中国汽车出口" : "Your Gateway to"}
        <br/>
        <span class="gradient-text">{isZh ? "值得信赖的伙伴" : "China's Finest Vehicles"}</span>
      </h1>

      <p class="text-lg md:text-xl text-apple-text-secondary mb-4 max-w-xl mx-auto leading-relaxed">
        {t("home.heroSubtitle")}
      </p>

      <div class="flex flex-wrap gap-4 justify-center mt-10">
        <a href={`${baseUrl}/products/`} class="btn-primary text-base">
          {t("home.heroCta")}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="#about" class="btn-outline text-base">
          {t("home.heroAbout")}
        </a>
      </div>

      <!-- Stats (Apple style glass cards) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-24 stagger">
        {[
          { num: "50+", label: t("home.stats_brands") },
          { num: "300+", label: t("home.stats_models") },
          { num: "50+", label: t("home.stats_countries") },
          { num: "1000+", label: t("home.stats_clients") },
        ].map(s => (
          <div class="card-glass p-6 text-center">
            <div class="text-3xl md:text-4xl font-bold text-apple-text mb-1">{s.num}</div>
            <div class="text-sm text-apple-text-secondary">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ ABOUT (Apple-style 2-col layout) ═══════════ -->
  <section id="about" class="section-gray">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div>
          <p class="section-label">{isZh ? "关于我们" : "About Us"}</p>
          <h2 class="section-heading mb-6">{t("home.companyIntro")}</h2>
          <p class="text-apple-text-secondary leading-relaxed text-lg mb-10">{t("home.companyDesc")}</p>
          <a href={`${baseUrl}/products/`} class="btn-primary">
            {t("home.heroCta")}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="rounded-3xl overflow-hidden shadow-md border border-gray-200/60" id="company-gallery">
          <div class="aspect-[4/3] overflow-hidden">
            <img id="gallery-main" src="/images/site/company/photo-01.jpg" alt={isZh ? "公司展厅" : "Showroom"} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
          </div>
          <div class="flex gap-1 p-2 bg-white" id="gallery-thumbs">
            {['01','02','03','04','05','06','07','08','09','10','11'].map((n,i) => (
              <button onclick={`document.getElementById('gallery-main').src='/images/site/company/photo-${n}.jpg'`} class={`w-10 h-8 rounded-md overflow-hidden border-2 transition-all flex-shrink-0 ${i===0?'border-apple-blue':'border-transparent hover:border-gray-300'}`}>
                <img src={`/images/site/company/photo-${n}.jpg`} alt="" class="w-full h-full object-cover" loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ WHY CHOOSE US (Apple-style feature cards) ═══════════ -->
  <section class="section-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <p class="section-label text-center">{isZh ? "为什么选择我们" : "Why Choose Us"}</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-apple-text mb-4">{t("home.whyTitle")}</h2>
        <p class="text-apple-text-secondary max-w-xl mx-auto text-lg">{isZh ? "专业诚信，赢得全球客户信赖" : "Earning global trust through expertise and integrity"}</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 stagger">
        {[
          { key: "Pricing", color: "text-apple-blue", icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
          { key: "Quality", color: "text-emerald-500", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
          { key: "Logistics", color: "text-purple-500", icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" },
          { key: "Support", color: "text-amber-500", icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" },
        ].map(f => (
          <div class="card p-8 text-center">
            <div class="w-14 h-14 bg-apple-gray rounded-2xl flex items-center justify-center mx-auto mb-5">
              <svg class={`w-6 h-6 ${f.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}/></svg>
            </div>
            <h3 class="text-lg font-bold text-apple-text mb-3">{t(`home.why${f.key}`)}</h3>
            <p class="text-sm text-apple-text-secondary leading-relaxed">{t(`home.why${f.key}Desc`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</MainLayout>
