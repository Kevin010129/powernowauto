---
export async function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}

import MainLayout from "../layouts/MainLayout.astro";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const isZh = lang === "zh";
const baseUrl = lang === "zh" ? "" : "/en";

const title = isZh ? "联系我们 — 常州后浪新能源汽车进出口有限公司" : "Contact Us — 常州后浪新能源汽车进出口有限公司";
const description = isZh ? "联系我们获取汽车出口咨询，24小时内回复。" : "Contact us for auto export inquiries. Response within 24 hours.";
---

<MainLayout {title} {description}>
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold">{isZh ? "联系我们" : "Contact Us"}</h1>
      <p class="text-blue-200 mt-2">{isZh ? "告诉我们您的需求，我们将在24小时内回复" : "Tell us your needs, we'll respond within 24 hours"}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-16">
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">{isZh ? "联系方式" : "Contact Info"}</h2>
            <div class="space-y-6">
              {[
                { icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z", label: isZh ? "地址" : "Address", value: isZh ? "常州市钟楼区怀德南路68号即刻加电" : "No.68 Huai De South Road, Zhonglou, Changzhou" },
                { icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", label: "Email", value: "info@houlang-auto.cn" },
                { icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z", label: isZh ? "电话" : "Phone", value: "+86 15852789535" },
              ].map((item) => (
                <div class="flex gap-4">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/></svg>
                  </div>
                  <div><h3 class="font-semibold text-gray-900 text-sm">{item.label}</h3><p class="text-gray-500 text-sm mt-1">{item.value}</p></div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-gray-warm rounded-2xl p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-2">{isZh ? "发送留言" : "Send a Message"}</h2>
            <p class="text-gray-500 text-sm mb-6">{isZh ? "我们将在 24 小时内回复您。" : "We'll get back to you within 24 hours."}</p>
            <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
              <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
              <input type="hidden" name="subject" value={`常州后浪新能源汽车进出口有限公司 contact (${lang})`} />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
              <div class="grid md:grid-cols-2 gap-5">
                <div><label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">{isZh ? "您的姓名" : "Your Name"} *</label><input type="text" name="name" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary/30 focus:ring-4 focus:ring-primary/5 text-sm bg-white" /></div>
                <div><label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Email *</label><input type="email" name="email" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary/30 focus:ring-4 focus:ring-primary/5 text-sm bg-white" /></div>
              </div>
              <div class="grid md:grid-cols-2 gap-5">
                <div><label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">{isZh ? "电话 / WhatsApp" : "Phone / WhatsApp"}</label><input type="text" name="phone" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary/30 focus:ring-4 focus:ring-primary/5 text-sm bg-white" /></div>
                <div><label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">{isZh ? "公司名称" : "Company"}</label><input type="text" name="company" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary/30 focus:ring-4 focus:ring-primary/5 text-sm bg-white" /></div>
              </div>
              <div><label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">{isZh ? "感兴趣的车型" : "Vehicles of Interest"}</label><input type="text" name="vehicles" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary/30 focus:ring-4 focus:ring-primary/5 text-sm bg-white" /></div>
              <div><label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">{isZh ? "留言" : "Message"} *</label><textarea name="message" rows="5" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-primary/30 focus:ring-4 focus:ring-primary/5 text-sm bg-white resize-none"></textarea></div>
              <button type="submit" class="btn-primary w-full justify-center py-4 text-base">{isZh ? "发送消息" : "Send Message"}</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
