---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { t } = useTranslations(lang);
const baseUrl = lang === "zh" ? "" : "/en";

const brandLinks = [
  "BYD", "NIO", "Xiaomi", "Li Auto", "Zeekr", "XPeng",
];

const typeLinks = [
  { key: "mini", href: `${baseUrl}/products/?type=MINI` },
  { key: "sedan", href: `${baseUrl}/products/?type=SEDAN` },
  { key: "suv", href: `${baseUrl}/products/?type=SUV` },
  { key: "mpv", href: `${baseUrl}/products/?type=MPV` },
];
const fuelLinks = [
  { key: "electric", href: `${baseUrl}/products/?fuel=electric` },
  { key: "phev", href: `${baseUrl}/products/?fuel=plug_in_hybrid` },
  { key: "erev", href: `${baseUrl}/products/?fuel=extended_range` },
  { key: "petrol", href: `${baseUrl}/products/?fuel=petrol` },
];
---

<footer class="bg-apple-gray border-t border-gray-200/60">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">

    <!-- Links (Apple-style text-only links) -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">
      <div>
        <h4 class="text-xs font-semibold text-apple-text mb-4 tracking-wide">{t("footer.brands")}</h4>
        <ul class="space-y-2.5">
          {brandLinks.map(b => (<li><a href={`${baseUrl}/brands/${b.toLowerCase().replace(/\s/g,'-')}/`} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{b}</a></li>))}
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-apple-text mb-4 tracking-wide">{t("footer.types")}</h4>
        <ul class="space-y-2.5">{typeLinks.map(i => (<li><a href={i.href} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{t(`filter.${i.key}`)}</a></li>))}</ul>
        <h4 class="text-xs font-semibold text-apple-text mt-8 mb-4 tracking-wide">{t("footer.fuel")}</h4>
        <ul class="space-y-2.5">{fuelLinks.map(i => (<li><a href={i.href} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{t(`filter.${i.key}`)}</a></li>))}</ul>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-apple-text mb-4 tracking-wide">{t("footer.quickLinks")}</h4>
        <ul class="space-y-2.5">
          <li><a href={`${baseUrl}/`} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{t("nav.home")}</a></li>
          <li><a href={`${baseUrl}/products/`} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{t("nav.products")}</a></li>
          <li><a href={`${baseUrl}/news/`} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{t("nav.news")}</a></li>
          <li><a href={`${baseUrl}/contact/`} class="text-sm text-apple-text-secondary hover:text-apple-blue transition-colors duration-150">{t("nav.contact")}</a></li>
        </ul>
      </div>
      <div class="col-span-2 md:col-span-2">
        <h4 class="text-xs font-semibold text-apple-text mb-4 tracking-wide">{t("footer.contact")}</h4>
        <ul class="space-y-3 text-sm text-apple-text-secondary">
          <li>{t("contact.email_address")}</li>
          <li>{t("contact.phone_number")}</li>
          <li>{lang === "zh" ? "常州市钟楼区怀德南路68号" : "No.68 Huai De South Rd, Changzhou"}</li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar (Apple-style minimal) -->
    <div class="pt-8 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p class="text-xs text-apple-text-secondary">{t("footer.copyright")}</p>
      <p class="text-xs text-gray-400">{lang === "zh" ? "中国汽车出口 · 全球信赖" : "China Auto Export · Trusted Worldwide"}</p>
    </div>
  </div>
</footer>
