---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { t } = useTranslations(lang);
const currentPath = Astro.url.pathname;
const baseUrl = lang === "zh" ? "" : "/en";

const navItems = [
  { key: "home", href: `${baseUrl}/` },
  { key: "products", href: `${baseUrl}/products/` },
  { key: "news", href: `${baseUrl}/news/` },
  { key: "contact", href: `${baseUrl}/contact/` },
];

const altLang = lang === "en" ? "zh" : "en";
const altPath = (() => {
  const path = currentPath.replace(/^\/en/, "") || "/";
  return lang === "zh" ? `/en${path}` : path;
})();

function isActive(href: string): boolean {
  if (href === `${baseUrl}/`) return currentPath === baseUrl + "/" || currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-gray-200/60">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 md:h-16">

      <!-- Logo (Apple-style compact) -->
      <a href={`${baseUrl}/`} class="flex items-center gap-2.5 flex-shrink-0 group">
        <div class="w-8 h-8 bg-apple-text rounded-lg flex items-center justify-center group-hover:scale-105 transition-transform">
          <span class="text-white font-bold text-xs">P</span>
        </div>
        <span class="hidden md:inline text-sm font-semibold text-apple-text tracking-tight">
          常州后浪汽车出口
        </span>
      </a>

      <!-- Desktop Nav (Apple-style centered) -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <a href={item.href} class={`relative px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
            isActive(item.href)
              ? "text-apple-blue"
              : "text-apple-text-secondary hover:text-apple-text hover:bg-gray-100/70"
          }`}>
            {t(`nav.${item.key}`)}
          </a>
        ))}
      </nav>

      <!-- Right -->
      <div class="flex items-center gap-3">
        <a href={altPath} class="text-xs font-semibold text-apple-text-secondary hover:text-apple-blue transition-colors px-3 py-1.5 rounded-full border border-gray-200 hover:border-apple-blue/30 hover:bg-apple-blue/[0.03]">
          {lang === "en" ? "中文" : "EN"}
        </a>
        <button id="menu-toggle" class="lg:hidden p-2 text-apple-text-secondary hover:text-apple-text transition-colors rounded-lg" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <nav id="mobile-menu" class="hidden lg:hidden pb-4">
      {navItems.map((item) => (
        <a href={item.href} class={`block px-4 py-3 rounded-lg text-base font-medium transition-all ${
          isActive(item.href) ? "text-apple-blue bg-apple-blue/[0.04]" : "text-apple-text-secondary hover:text-apple-text hover:bg-gray-50"
        }`}>
          {t(`nav.${item.key}`)}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>document.getElementById("menu-toggle")?.addEventListener("click",()=>{document.getElementById("mobile-menu")?.classList.toggle("hidden")});</script>
