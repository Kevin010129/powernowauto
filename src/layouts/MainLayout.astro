---
import Head from "../components/base/Head.astro";
import Header from "../components/base/Header.astro";
import Footer from "../components/base/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";

interface Props { title: string; description: string; ogImage?: string; }
const { title, description, ogImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const baseUrl = lang === "zh" ? "" : "/en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Head {title} {description} {lang} {ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
    <!-- Floating CTA (Apple fixed-bottom capsule) -->
    <a href={`${baseUrl}/contact/`} class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-apple-text text-white px-8 py-3.5 rounded-full shadow-xl shadow-black/10 hover:shadow-2xl hover:shadow-black/15 hover:scale-[1.02] transition-all duration-300 flex items-center gap-2.5 text-sm font-semibold tracking-wide" id="floating-cta">
      <span class="w-2 h-2 bg-apple-blue rounded-full animate-pulse"></span>
      <span>{lang === "zh" ? "立即咨询" : "Inquire Now"}</span>
    </a>
  </body>
</html>
